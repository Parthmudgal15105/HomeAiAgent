[Unit]
Description=AI Home-Lab constrained diagnostic gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=aiops-gateway
Group=aiops-gateway
SupplementaryGroups=docker systemd-journal
WorkingDirectory=/opt/aiops-gateway
EnvironmentFile=/etc/aiops-gateway.env
# Defaults to host-only. A root-owned drop-in may set this to the host's
# Tailscale address for a private remote controller; never bind 0.0.0.0.
Environment=GATEWAY_BIND_HOST=127.0.0.1
Environment=GATEWAY_CONFIG_PATH=/opt/aiops-gateway/config/gateway.json
Environment=GATEWAY_STATE_PATH=/var/lib/aiops-gateway/approvals.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/aiops-gateway/venv/bin/uvicorn diagnostic_gateway.main:app --host ${GATEWAY_BIND_HOST} --port 18081 --workers 1 --limit-concurrency 12 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aiops-gateway
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
MemoryMax=256M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
